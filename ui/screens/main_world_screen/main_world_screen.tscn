[sub_resource type="Resource" id="Resource_wtwi_0"]
script = ExtResource("27_twi")
index = -1
text = "Welcome to the World Map!
in this map, you will explore the world, fighting monsters and finding different events.
To do that, simply click on one of the highligthed nodes after this tutorial.
Right-click to continue."

[sub_resource type="Resource" id="Resource_wtwi_1"]
script = ExtResource("27_twi")
text = "This is your [b]Village[/b] - your safe haven.
Right-click to continue."

