[resource]
script = ExtResource("1_config")
title = "A New Horizon"
description = "The grateful villagers cheer as you prepare to depart. Word has spread of your heroics, and a desperate plea arrives from a distant settlement besieged by monsters.
Before you leave, the village elder grants you access to their ancient Deforge station - a rare opportunity to reshape your cards for the battles ahead."
